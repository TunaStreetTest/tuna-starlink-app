# Apex only. A www site block needs a DNS record or certificate issuance fails.
{$PUBLIC_HOST} {
	encode zstd gzip
	root * /srv/site

	# BrainShare #606: THE X-Loops app. Goes inside the {$PUBLIC_HOST} block of tuna-starlink-app
	# deploy/public/Caddyfile, ahead of the catch-all handle. The app serves under /x-loops itself, so the path is
	# not stripped; flush_interval -1 keeps the screen stream (server-sent events) unbuffered.
	handle /x-loops* {
		header Strict-Transport-Security "max-age=31536000"
		reverse_proxy xloops:8780 {
			flush_interval -1
		}
	}

	handle /media/* {
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle /api/* {
		respond "not found" 404
	}

	handle /feed.json {
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
